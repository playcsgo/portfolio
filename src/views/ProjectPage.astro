---
import Base from '../layouts/Base.astro';
import Flow from '../components/Flow.astro';
import Screenshot from '../components/Screenshot.astro';
import CodeWindow from '../components/CodeWindow.astro';
import type { Lang, Project } from '../data/projects';
import { t, tx, href } from '../data/site';

interface Props {
  lang: Lang;
  project: Project;
}
const { lang, project: p } = Astro.props;
---

<Base lang={lang} title={tx(lang, p.title)} description={tx(lang, p.tagline)}>
  <a class="back" href={href(lang, '/#projects')}>← {t(lang, 'back')}</a>

  <header class="top">
    <div class="meta">
      <span class="mono">{p.period}</span>
      <span class:list={['badge', p.status]}>{t(lang, `status_${p.status}`)}</span>
    </div>
    <h1>{tx(lang, p.title)}</h1>
    <p class="lede">{tx(lang, p.tagline)}</p>
    {
      p.links.length > 0 && (
        <div class="links">
          {p.links.map((l) => (
            <a href={typeof l.href === 'string' ? l.href : tx(lang, l.href)} target="_blank" rel="noopener">
              {tx(lang, l.label)} ↗
            </a>
          ))}
        </div>
      )
    }
  </header>

  {
    p.shots && (
      <div class="shots">
        {p.shots.map((s, i) => (
          <Screenshot lang={lang} shot={s} eager={i === 0} sizes={i === 0 ? undefined : '(min-width: 720px) 440px, 100vw'} />
        ))}
      </div>
    )
  }

  <dl class="facts">
    <div>
      <dt class="eyebrow">{t(lang, 'role')}</dt>
      <dd>{tx(lang, p.role)}</dd>
    </div>
    <div>
      <dt class="eyebrow">{t(lang, 'stack')}</dt>
      <dd><ul class="tags">{p.stack.map((s) => <li>{s}</li>)}</ul></dd>
    </div>
  </dl>

  {
    p.stats && (
      <dl class="stats">
        {p.stats.map((s) => (
          <div>
            <dd class="mono">{s.value}</dd>
            <dt>{tx(lang, s.label)}</dt>
          </div>
        ))}
      </dl>
    )
  }

  <section>
    <h2>{t(lang, 'problem')}</h2>
    <p>{tx(lang, p.problem)}</p>
  </section>

  {p.flow && <section><Flow lang={lang} flow={p.flow} /></section>}

  <section>
    <h2>{t(lang, 'highlights')}</h2>
    <div class="highlights">
      {
        p.highlights.map((h, i) => (
          <article>
            <h3>
              <span class="mono idx">{String(i + 1).padStart(2, '0')}</span>
              {tx(lang, h.title)}
            </h3>
            <p>{tx(lang, h.body)}</p>
            {h.ref && (
              <p class="ref mono">
                {t(lang, 'code')}: <code>{h.ref}</code>
              </p>
            )}
          </article>
        ))
      }
    </div>
  </section>

  {
    p.code && (
      <section>
        <CodeWindow lang={lang} code={p.code} />
      </section>
    )
  }

  {
    p.roadmap && (
      <section class="roadmap">
        <h2>{tx(lang, p.roadmap.title)}</h2>
        <p>{tx(lang, p.roadmap.intro)}</p>
        <ul>
          {p.roadmap.items.map((i) => (
            <li>{tx(lang, i)}</li>
          ))}
        </ul>
      </section>
    )
  }

  {
    p.learned && (
      <section>
        <h2>{t(lang, 'learned')}</h2>
        <ul class="learned">
          {p.learned.map((l) => (
            <li>{tx(lang, l)}</li>
          ))}
        </ul>
      </section>
    )
  }
</Base>

<style>
  .back {
    display: inline-block;
    margin-top: 32px;
    font-size: 14px;
    color: var(--muted);
  }
  .top {
    padding: 24px 0 32px;
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--faint);
    font-size: 13px;
  }
  h1 {
    font-size: clamp(30px, 5.5vw, 44px);
    margin: 12px 0;
  }
  .lede {
    font-size: 18px;
    color: var(--muted);
    max-width: 720px;
    margin: 0;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 20px;
    font-weight: 500;
  }
  .shots {
    display: grid;
    gap: 32px 24px;
    margin-bottom: 40px;
  }
  /* First screenshot spans full width, the rest go two per row */
  @media (min-width: 720px) {
    .shots {
      grid-template-columns: 1fr 1fr;
    }
    .shots > :global(:first-child) {
      grid-column: 1 / -1;
    }
  }
  /* Tall screenshots would dominate at full width; show only the top */
  .shots > :global(:first-child img) {
    max-height: 520px;
    object-fit: cover;
    object-position: top;
  }
  .facts {
    display: grid;
    gap: 20px;
    margin: 0 0 24px;
    padding: 20px 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  @media (min-width: 720px) {
    .facts {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }
  }
  .facts dd {
    margin: 0;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 12px;
    margin: 0 0 16px;
  }
  .stats div {
    padding: 14px 16px;
    border-radius: var(--radius);
    background: var(--surface-2);
  }
  .stats dd {
    margin: 0;
    font-size: 26px;
    font-weight: 500;
  }
  .stats dt {
    font-size: 13px;
    color: var(--muted);
  }
  section {
    margin-top: 40px;
  }
  section > p {
    max-width: 720px;
  }
  h2 {
    font-size: 22px;
    margin: 0 0 12px;
  }
  .highlights {
    display: grid;
    gap: 16px;
  }
  @media (min-width: 720px) {
    .highlights {
      grid-template-columns: 1fr 1fr;
    }
  }
  .highlights article {
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .highlights h3 {
    font-size: 17px;
    margin: 0 0 8px;
    display: flex;
    gap: 10px;
    align-items: baseline;
  }
  .idx {
    color: var(--accent);
    font-weight: 500;
  }
  .highlights p {
    margin: 0;
    color: var(--muted);
    font-size: 15px;
  }
  .highlights .ref {
    margin-top: 12px;
    font-size: 12px;
    color: var(--faint);
  }
  .ref code {
    font-size: 12px;
    color: var(--text);
  }
  .roadmap {
    padding: 24px;
    border-radius: var(--radius);
    border: 1px dashed var(--warn);
    background: var(--warn-soft);
  }
  .roadmap h2 {
    color: var(--warn);
  }
  .roadmap ul,
  .learned {
    margin: 0;
    padding-left: 20px;
  }
  .roadmap li,
  .learned li {
    margin: 6px 0;
  }
</style>
