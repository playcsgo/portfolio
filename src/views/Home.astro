---
import Base from '../layouts/Base.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { projects, type Lang } from '../data/projects';
import { site, t, tx, shortTitle } from '../data/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const liveCount = projects.filter((p) => p.status === 'live').length;
const statusCode = { live: 'LIVE', 'in-progress': 'WIP', archived: 'ARCHIVE' } as const;
// Fixed jitter for the "vague" line: rotation (deg) and vertical offset (em), cycled per glyph
const jitter = [[-6, 0.03], [4, -0.06], [-3, 0.07], [7, 0], [-5, -0.04], [3, 0.06]];
const messy = tx(lang, site.headline.messy);
const glyphs = lang === 'zh' ? [...messy] : messy.split(/(\s+)/).filter(Boolean);
const yearOf = (period: string) => period.replace(/(\d{4})\.(\d{2}) – \1\.(\d{2})/, '$1.$2–$3');
---

<Base lang={lang} wide>
  <section class="hero">
    <p class="eyebrow who">{tx(lang, site.name)} — {tx(lang, site.role)}</p>
    <h1>
      <span class="sr-only">{messy} {tx(lang, site.headline.strong)}</span>
      <span class="messy" aria-hidden="true">
        {
          glyphs.map((g, i) => {
            const [deg, y] = jitter[i % jitter.length];
            return /^\s+$/.test(g) ? g : <span style={`transform: rotate(${deg}deg) translateY(${y}em)`}>{g}</span>;
          })
        }
      </span>
      <span class="strong" aria-hidden="true">{tx(lang, site.headline.strong)}</span>
    </h1>
    <dl class="stats">
      {
        site.stats.map((s) => (
          <div>
            <dd>{tx(lang, s.value)}</dd>
            <dt>{tx(lang, s.label)}</dt>
          </div>
        ))
      }
    </dl>
  </section>

  <section id="index" class="index">
    <div class="label mono">
      <span>01 / {t(lang, 'index_title')}</span>
      <span>{projects.length} PROJECTS · {liveCount} LIVE</span>
    </div>
    <div class="table" role="table">
      <div class="thead" role="row">
        <span role="columnheader">#</span>
        <span role="columnheader">PROJECT</span>
        <span role="columnheader" class="c-stack">STACK</span>
        <span role="columnheader">STATUS</span>
        <span role="columnheader" class="c-year">YEAR</span>
        <span class="arrow" aria-hidden="true"></span>
      </div>
      {
        projects.map((p, i) => (
          <a class="tr" role="row" href={`#${p.slug}`}>
            <span role="cell" class="num">{String(i + 1).padStart(2, '0')}</span>
            <span role="cell" class="name">
              {shortTitle(lang, p.title)}
              <small>{p.home.index}</small>
            </span>
            <span role="cell" class="c-stack">{p.home.index}</span>
            <span role="cell"><span class:list={['badge', p.status]}>{statusCode[p.status]}</span></span>
            <span role="cell" class="c-year">{yearOf(p.period)}</span>
            <span class="arrow" aria-hidden="true">↓</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="works">
    <div class="label mono">
      <span>02 / {t(lang, 'works_title')}</span>
      <span class="hint">{t(lang, 'works_hint')}</span>
    </div>
    {projects.map((p, i) => <ProjectRow lang={lang} project={p} index={i} />)}
  </section>

  <section id="experience" class="experience">
    <div class="label mono"><span>03 / {t(lang, 'experience')}</span></div>
    <div class="exp-body">
      <h2>{t(lang, 'experience_heading')}</h2>
      <ol>
        {
          site.experience.map((e) => (
            <li>
              <span class="org">
                {e.org} · {tx(lang, e.role)}
              </span>
              <span class="period mono">{tx(lang, e.period)}</span>
              <span class="note">{tx(lang, e.note)}</span>
            </li>
          ))
        }
      </ol>
      <p class="edu">{tx(lang, site.education)}</p>
    </div>
  </section>
</Base>

<style>
  section {
    scroll-margin-top: 88px;
  }
  .label {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font-size: 13px;
    color: var(--muted);
  }

  .hero {
    padding: 72px 0 64px;
  }
  @media (min-width: 900px) {
    .hero {
      padding: 128px 0 96px;
    }
  }
  .who {
    margin-bottom: 24px;
  }
  h1 {
    margin: 0;
    font-size: clamp(32px, 5vw, 68px);
    line-height: 1.12;
    letter-spacing: -0.02em;
    max-width: 1200px;
  }
  h1 > span {
    display: block;
  }
  .messy {
    margin-bottom: 0.08em;
    color: var(--faint);
  }
  .messy span {
    display: inline-block;
  }
  .strong {
    white-space: pre-line;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .stats {
    display: grid;
    margin: 56px 0 0;
    border-top: 1px solid var(--border);
    max-width: 960px;
  }
  .stats div {
    display: flex;
    flex-direction: row-reverse;
    justify-content: space-between;
    align-items: baseline;
    padding: 14px 0;
    border-bottom: 1px solid var(--border);
  }
  .stats dd {
    margin: 0;
    font-size: 24px;
    font-weight: 600;
  }
  .stats dt {
    color: var(--muted);
    font-size: 15px;
  }
  @media (min-width: 720px) {
    .stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 32px;
      padding-top: 24px;
    }
    .stats div {
      flex-direction: column;
      justify-content: flex-start;
      gap: 6px;
      padding: 0;
      border: 0;
    }
    .stats dd {
      font-size: 36px;
      letter-spacing: -0.02em;
    }
  }

  /* Project index: monospace table; hovering a row dims the others */
  .index {
    padding: 24px 0 112px;
  }
  .table {
    margin-top: 16px;
    font-family: var(--mono);
    font-size: 15px;
  }
  .thead,
  .tr {
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr) auto;
    gap: 12px;
    align-items: center;
    padding: 0 12px;
  }
  .thead {
    padding-bottom: 12px;
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--faint);
    border-bottom: 1px solid var(--text);
  }
  .c-stack,
  .c-year,
  .arrow {
    display: none;
  }
  .tr {
    min-height: 64px;
    border-bottom: 1px solid var(--border);
    color: var(--text);
    transition: opacity 0.25s ease;
  }
  .tr:hover {
    text-decoration: none;
  }
  .tr:focus-visible {
    outline: 1px solid var(--text);
    outline-offset: -1px;
  }
  .tr .arrow {
    transition: transform 0.25s ease;
  }
  @media (hover: hover) {
    .table:hover .tr:not(:hover) {
      opacity: 0.3;
    }
    .tr:hover .arrow {
      transform: translateY(3px);
    }
  }
  .num {
    color: var(--faint);
  }
  .name {
    display: flex;
    flex-direction: column;
    padding: 10px 0;
    font-weight: 500;
    text-transform: uppercase;
    line-height: 1.4;
  }
  .name small {
    font-size: 11px;
    font-weight: 400;
    text-transform: none;
    color: var(--muted);
  }
  @media (min-width: 900px) {
    .thead,
    .tr {
      grid-template-columns: 56px 280px minmax(0, 1fr) 130px 150px 24px;
      gap: 16px;
      padding: 0 16px;
    }
    .c-stack,
    .c-year,
    .arrow {
      display: block;
    }
    .name small {
      display: none;
    }
    .c-stack {
      color: var(--muted);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }

  .works {
    display: flex;
    flex-direction: column;
    gap: 72px;
  }
  @media (min-width: 900px) {
    .works {
      gap: 96px;
    }
  }
  .works > .label {
    padding-top: 20px;
    border-top: 1px solid var(--border);
    margin-bottom: -24px;
  }
  @media (max-width: 719px) {
    .hint {
      display: none;
    }
  }

  .experience {
    display: grid;
    gap: 24px;
    margin-top: 128px;
  }
  .experience > .label,
  .exp-body {
    padding-top: 20px;
    border-top: 1px solid var(--border);
  }
  @media (min-width: 900px) {
    .experience {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 32px;
    }
    .experience > .label {
      grid-column: span 4;
      align-self: start;
    }
    .exp-body {
      grid-column: span 8;
    }
  }
  .exp-body h2 {
    margin: 0 0 40px;
    font-size: clamp(28px, 3.4vw, 48px);
    line-height: 1.15;
    white-space: pre-line;
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--border);
  }
  li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 6px 24px;
    padding: 20px 0;
    border-top: 1px solid var(--border);
  }
  .org {
    font-size: 18px;
    font-weight: 500;
  }
  .period {
    font-size: 13px;
    color: var(--muted);
    text-align: right;
    padding-top: 4px;
  }
  .note {
    grid-column: 1 / -1;
    font-size: 15px;
    color: var(--muted);
  }
  @media (max-width: 599px) {
    li {
      grid-template-columns: 1fr;
    }
    .period {
      order: -1;
      text-align: left;
      padding: 0;
    }
  }
  .edu {
    margin: 20px 0 0;
    font-size: 14px;
    color: var(--muted);
  }
</style>
