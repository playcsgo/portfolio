---
import type { Lang } from '../data/projects';
import { site, t, tx, altPath, href, BASE } from '../data/site';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Full-width layout for the home page; project pages keep a reading width */
  wide?: boolean;
}
const { lang, title, description, wide = false } = Astro.props;
const pageTitle = title ? `${title} · ${tx(lang, site.name)}` : `${tx(lang, site.name)} · ${tx(lang, site.role)}`;
const path = Astro.url.pathname;
const { links } = site;
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-Hant-TW' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${BASE}/favicon.svg`} />
    <title>{pageTitle}</title>
    <meta name="description" content={description ?? tx(lang, site.intro)} />
    <link rel="alternate" hreflang={lang === 'zh' ? 'en' : 'zh-Hant-TW'} href={altPath(lang, path)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&family=Noto+Sans+TC:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Apply the saved theme before first paint to avoid a flash
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap-wide header-inner">
        <a class="brand" href={href(lang, '/')}>Portfolio</a>
        <nav class="primary">
          <a href={href(lang, '/#index')}>{t(lang, 'nav_projects')}</a>
          <a href={href(lang, '/#experience')}>{t(lang, 'nav_experience')}</a>
          <a href={href(lang, '/#contact')}>{t(lang, 'nav_contact')}</a>
        </nav>
        <div class="pills">
          <button class="theme-switch" type="button" role="switch" aria-checked="false" aria-label={lang === 'zh' ? '深色模式' : 'Dark mode'}>
            <span class="track">
              <svg class="sun" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
              <svg class="moon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path></svg>
              <span class="knob">
                <svg class="sun" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
                <svg class="moon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path></svg>
              </span>
            </span>
          </button>
          <a class="pill" href={altPath(lang, path)} hreflang={lang === 'zh' ? 'en' : 'zh-Hant-TW'}>{t(lang, 'switch_lang')}</a>
          {links.resume && <a class="pill solid" href={links.resume} target="_blank" rel="noopener">{t(lang, 'resume')} ↗</a>}
        </div>
      </div>
    </header>

    <main class={wide ? 'wrap-wide' : 'wrap'}>
      <slot />
    </main>

    <footer id="contact" class="site-footer">
      <div class="wrap-wide">
        <div class="footer-top">
          <div>
            <p class="eyebrow">{t(lang, 'contact')}</p>
            <h2>{t(lang, 'contact_body')}</h2>
          </div>
          <a class="mail" href={`mailto:${links.email}`}>{links.email} ↗</a>
        </div>
        <div class="footer-bottom">
          <span>© {new Date().getFullYear()} {tx(lang, site.name)} · {t(lang, 'footer')}</span>
          <div>
            <a href={links.github} target="_blank" rel="noopener">GitHub ↗</a>
            {links.linkedin && <a href={links.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>}
            {links.resume && <a href={links.resume} target="_blank" rel="noopener">{t(lang, 'resume')} ↗</a>}
          </div>
        </div>
      </div>
    </footer>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const btn = document.querySelector('.theme-switch');
        const isDark = () => (root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches);
        const sync = () => btn.setAttribute('aria-checked', String(isDark()));
        sync();
        matchMedia('(prefers-color-scheme: dark)').addEventListener('change', sync);
        btn.addEventListener('click', () => {
          root.dataset.theme = isDark() ? 'light' : 'dark';
          sync();
          try {
            localStorage.setItem('theme', root.dataset.theme);
          } catch {}
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f4f3ef;
    --surface: #fbfaf7;
    --surface-2: #ebeae4;
    --text: #141414;
    --body: #3d3b35;
    --muted: #5a5850;
    --faint: #6b685f;
    --border: #dad8d0;
    --border-strong: #c9c6bc;
    --accent: #b8430f;
    --accent-soft: #f6e3d8;
    --dot: #e2571c;
    --live: #2f8a3e;
    --warn: #a15c07;
    --warn-soft: #f6ebd9;
    --invert-bg: #141414;
    --invert-fg: #f4f3ef;
    --invert-muted: #c9c6bc;
    --footer-bg: #141414;
    --footer-fg: #f4f3ef;
    --footer-muted: #a29e93;
    --radius: 10px;
    --shadow-sm: 0 1px 1px #00000005, 0 2px 2px #0000000a;
    --shadow-md: 0 2px 2px #0000000a, 0 8px 16px -4px #0000000f;
    --shadow-lg: 0 1px 1px #00000005, 0 8px 16px -4px #0000000a, 0 24px 32px -8px #00000014;
    --sans: 'Geist', 'Noto Sans TC', system-ui, sans-serif;
    --mono: 'Geist Mono', ui-monospace, monospace;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) {
      --bg: #121211;
      --surface: #1a1917;
      --surface-2: #22211e;
      --text: #edebe4;
      --body: #cfccc3;
      --muted: #a9a69c;
      --faint: #8c897f;
      --border: #2c2b27;
      --border-strong: #3d3b36;
      --accent: #f08a4b;
      --accent-soft: #3a2416;
      --dot: #f06a2e;
    --live: #4cc265;
      --live: #4cc265;
      --warn: #f0a94b;
      --warn-soft: #34270f;
      --invert-bg: #edebe4;
      --invert-fg: #121211;
      --invert-muted: #5a5850;
      --footer-bg: #0a0a09;
      --footer-fg: #edebe4;
      --footer-muted: #8c897f;
      color-scheme: dark;
    }
  }
  :root[data-theme='dark'] {
    --bg: #121211;
    --surface: #1a1917;
    --surface-2: #22211e;
    --text: #edebe4;
    --body: #cfccc3;
    --muted: #a9a69c;
    --faint: #8c897f;
    --border: #2c2b27;
    --border-strong: #3d3b36;
    --accent: #f08a4b;
    --accent-soft: #3a2416;
    --dot: #f06a2e;
    --live: #4cc265;
    --warn: #f0a94b;
    --warn-soft: #34270f;
    --invert-bg: #edebe4;
    --invert-fg: #121211;
    --invert-muted: #5a5850;
    --footer-bg: #0a0a09;
    --footer-fg: #edebe4;
    --footer-muted: #8c897f;
    color-scheme: dark;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    scroll-behavior: smooth;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: var(--sans);
    font-size: 16px;
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
  }
  a {
    color: var(--accent);
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  h1,
  h2,
  h3 {
    line-height: 1.2;
    font-weight: 600;
  }
  /* Tighten tracking on English headings only; CJK glyphs crowd when tracked negatively */
  :lang(en) h1 {
    letter-spacing: -0.035em;
  }
  :lang(en) h2,
  :lang(en) h3 {
    letter-spacing: -0.02em;
  }
  code,
  .mono {
    font-family: var(--mono);
    font-size: 0.86em;
  }
  .wrap,
  .wrap-wide {
    margin: 0 auto;
    padding: 0 20px;
  }
  .wrap {
    max-width: 1000px;
  }
  .wrap-wide {
    max-width: 1440px;
  }
  @media (min-width: 720px) {
    .wrap,
    .wrap-wide {
      padding: 0 40px;
    }
  }
  @media (min-width: 1100px) {
    .wrap-wide {
      padding: 0 80px;
    }
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 90%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
    gap: 16px;
  }
  .brand {
    font-family: var(--mono);
    font-weight: 500;
    font-size: 15px;
    color: var(--text);
  }
  .site-header a:hover {
    text-decoration: none;
  }
  .primary {
    display: none;
    gap: 40px;
    font-size: 15px;
  }
  .primary a {
    color: var(--text);
  }
  .primary a:hover {
    color: var(--muted);
  }
  @media (min-width: 720px) {
    .primary {
      display: flex;
    }
  }
  .pills {
    display: flex;
    gap: 8px;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    height: 44px;
    padding: 0 16px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    font-family: var(--mono);
    font-size: 13px;
    color: var(--text);
  }
  .pill:hover {
    border-color: var(--text);
  }
  /* Slider switch: knob on the left with a sun in light mode, slides right with a moon in dark mode */
  .theme-switch {
    display: inline-flex;
    align-items: center;
    height: 44px;
    padding: 0 4px;
    border: 0;
    background: none;
    cursor: pointer;
    color: var(--text);
  }
  .track {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 60px;
    height: 32px;
    padding: 0 8px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: var(--surface-2);
    color: var(--faint);
    transition: border-color 0.2s, background 0.2s;
  }
  .theme-switch:hover .track {
    border-color: var(--text);
  }
  .theme-switch:focus-visible {
    outline: none;
  }
  .theme-switch:focus-visible .track {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .knob {
    position: absolute;
    top: 3px;
    left: 3px;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--invert-bg);
    color: var(--invert-fg);
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.25);
    transition: transform 0.25s cubic-bezier(0.3, 0.7, 0.4, 1);
  }
  .knob svg {
    grid-area: 1 / 1;
  }
  .knob .moon {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .knob {
      transform: translateX(28px);
    }
    :root:not([data-theme='light']) .knob .sun {
      display: none;
    }
    :root:not([data-theme='light']) .knob .moon {
      display: block;
    }
  }
  :root[data-theme='dark'] .knob {
    transform: translateX(28px);
  }
  :root[data-theme='dark'] .knob .sun {
    display: none;
  }
  :root[data-theme='dark'] .knob .moon {
    display: block;
  }
  @media (prefers-reduced-motion: reduce) {
    .knob {
      transition: none;
    }
  }
  .pill.solid {
    background: var(--invert-bg);
    border-color: var(--invert-bg);
    color: var(--invert-fg);
  }

  .site-footer {
    margin-top: 128px;
    padding: 96px 0 40px;
    background: var(--footer-bg);
    color: var(--footer-fg);
  }
  .site-footer .eyebrow {
    color: var(--footer-muted);
  }
  .footer-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px 48px;
  }
  .footer-top h2 {
    margin: 0;
    font-size: clamp(36px, 6vw, 72px);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }
  .site-footer a {
    color: var(--footer-fg);
  }
  .mail {
    font-size: clamp(18px, 2vw, 24px);
    padding-bottom: 4px;
    border-bottom: 1px solid var(--footer-fg);
  }
  .site-footer .mail:hover {
    text-decoration: none;
    opacity: 0.8;
  }
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px 32px;
    margin-top: 72px;
    padding-top: 24px;
    border-top: 1px solid color-mix(in srgb, var(--footer-fg) 20%, transparent);
    font-family: var(--mono);
    font-size: 13px;
    color: var(--footer-muted);
  }
  .footer-bottom div {
    display: flex;
    gap: 32px;
  }

  .eyebrow {
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0.02em;
    color: var(--muted);
    margin: 0 0 12px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .tags li {
    font-family: var(--mono);
    font-size: 12px;
    padding: 4px 10px;
    border-radius: 6px;
    border: 1px solid var(--border-strong);
    color: var(--text);
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
    white-space: nowrap;
  }
  .badge::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    border: 1px solid var(--faint);
  }
  .badge.live::before {
    background: var(--live);
    border-color: var(--live);
  }
  .badge.in-progress::before {
    background: var(--warn);
    border-color: var(--warn);
  }
</style>
