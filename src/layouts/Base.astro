---
import type { Lang } from '../data/projects';
import { site, t, tx, altPath, href, BASE } from '../data/site';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
}
const { lang, title, description } = Astro.props;
const pageTitle = title ? `${title} · ${tx(lang, site.name)}` : `${tx(lang, site.name)} · ${tx(lang, site.role)}`;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-Hant-TW' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${BASE}/favicon.svg`} />
    <title>{pageTitle}</title>
    <meta name="description" content={description ?? tx(lang, site.intro)} />
    <link rel="alternate" hreflang={lang === 'zh' ? 'en' : 'zh-Hant-TW'} href={altPath(lang, path)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Noto+Sans+TC:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href={href(lang, '/')}>
          <span class="brand-mark">~/</span>samlu
        </a>
        <nav>
          <a href={href(lang, '/#projects')}>{t(lang, 'nav_projects')}</a>
          <a href={href(lang, '/#skills')}>{t(lang, 'nav_skills')}</a>
          <a href={href(lang, '/#contact')}>{t(lang, 'nav_contact')}</a>
          <a class="lang" href={altPath(lang, path)} hreflang={lang === 'zh' ? 'en' : 'zh-Hant-TW'}>{t(lang, 'switch_lang')}</a>
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="wrap site-footer">
      <span>© {new Date().getFullYear()} {tx(lang, site.name)}</span>
      <span>{t(lang, 'footer')}</span>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fbfbf9;
    --surface: #ffffff;
    --surface-2: #f3f3ef;
    --text: #1b1d1f;
    --muted: #5d6166;
    --faint: #8a8e93;
    --border: #e3e3dd;
    --accent: #0f766e;
    --accent-soft: #e2f3f0;
    --warn: #b45309;
    --warn-soft: #fdf1e2;
    --radius: 8px;
    --shadow-sm: 0 1px 1px #00000005, 0 2px 2px #0000000a;
    --shadow-md: 0 2px 2px #0000000a, 0 8px 16px -4px #0000000f;
    --shadow-lg: 0 1px 1px #00000005, 0 8px 16px -4px #0000000a, 0 24px 32px -8px #00000014;
    --sans: 'IBM Plex Sans', 'Noto Sans TC', system-ui, sans-serif;
    --mono: 'JetBrains Mono', ui-monospace, monospace;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) {
      --bg: #111315;
      --surface: #181b1e;
      --surface-2: #1f2327;
      --text: #e8e9ea;
      --muted: #a4a9ae;
      --faint: #767b81;
      --border: #2b3035;
      --accent: #4fd1c0;
      --accent-soft: #15302d;
      --warn: #f0a94b;
      --warn-soft: #34270f;
      color-scheme: dark;
    }
  }
  :root[data-theme='dark'] {
    --bg: #111315;
    --surface: #181b1e;
    --surface-2: #1f2327;
    --text: #e8e9ea;
    --muted: #a4a9ae;
    --faint: #767b81;
    --border: #2b3035;
    --accent: #4fd1c0;
    --accent-soft: #15302d;
    --warn: #f0a94b;
    --warn-soft: #34270f;
    color-scheme: dark;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    scroll-behavior: smooth;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: var(--sans);
    font-size: 16px;
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
  }
  a {
    color: var(--accent);
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  h1,
  h2,
  h3 {
    line-height: 1.25;
    font-weight: 600;
  }
  /* Tighten tracking on English headings only; CJK glyphs crowd when tracked negatively */
  :lang(en) h1 {
    letter-spacing: -0.04em;
  }
  :lang(en) h2,
  :lang(en) h3 {
    letter-spacing: -0.02em;
  }
  code,
  .mono {
    font-family: var(--mono);
    font-size: 0.86em;
  }
  .wrap {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 16px;
  }
  @media (min-width: 720px) {
    .wrap {
      padding: 0 32px;
    }
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
    gap: 16px;
  }
  .brand {
    font-family: var(--mono);
    font-weight: 500;
    color: var(--text);
  }
  .brand-mark {
    color: var(--accent);
  }
  .site-header nav {
    display: flex;
    gap: 18px;
    font-size: 14px;
  }
  .site-header nav a {
    color: var(--muted);
  }
  .site-header nav a:hover {
    color: var(--text);
    text-decoration: none;
  }
  .site-header nav .lang {
    font-family: var(--mono);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0 8px;
    color: var(--text);
  }
  @media (max-width: 480px) {
    .site-header nav a:not(.lang):not(:first-child) {
      display: none;
    }
  }

  .site-footer {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 96px;
    padding-top: 24px;
    padding-bottom: 40px;
    border-top: 1px solid var(--border);
    color: var(--faint);
    font-size: 13px;
  }

  .eyebrow {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--faint);
    margin: 0 0 12px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .tags li {
    font-family: var(--mono);
    font-size: 12px;
    padding: 2px 8px;
    border-radius: 6px;
    background: var(--surface-2);
    color: var(--muted);
    border: 1px solid var(--border);
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--mono);
    font-size: 12px;
    padding: 2px 8px;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--muted);
    white-space: nowrap;
  }
  .badge::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--faint);
  }
  .badge.live::before {
    background: var(--accent);
  }
  .badge.in-progress::before {
    background: var(--warn);
  }
</style>
