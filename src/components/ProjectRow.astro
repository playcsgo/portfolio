---
import ProjectPanel from './ProjectPanel.astro';
import type { Lang, LinkKind, Project } from '../data/projects';
import { t, tx, href, shortTitle } from '../data/site';

interface Props {
  lang: Lang;
  project: Project;
  index: number;
}
const { lang, project: p, index } = Astro.props;
const url = href(lang, `/${p.slug}/`);
const linkLabel: Record<LinkKind, string> = {
  web: 'Web',
  ios: 'App Store',
  android: 'Google Play',
  chrome: lang === 'zh' ? 'Chrome 擴充功能' : 'Chrome extension',
  github: 'GitHub',
};
const cardLinks = (p.home.links ?? []).map((l) => ({
  label: linkLabel[l.kind],
  href: typeof l.href === 'string' ? l.href : tx(lang, l.href),
}));
const num = String(index + 1).padStart(2, '0');
---

<article id={p.slug} class="row">
  <div class="text">
    <p class="meta mono">{num} · {p.period} · {tx(lang, p.home.byline)}</p>
    <h2><a href={url}>{shortTitle(lang, p.title)}</a></h2>
    {
      p.home.points ? (
        <>
          <p class="blurb">{tx(lang, p.home.points.intro)}</p>
          <div class="barrier">
            <p class="mono">{t(lang, 'barrier')}</p>
            <p>{tx(lang, p.home.points.barrier)}</p>
          </div>
        </>
      ) : (
        p.home.blurb && <p class="blurb">{tx(lang, p.home.blurb)}</p>
      )
    }
    <ul class="tags">{p.home.tags.map((s) => <li>{s}</li>)}</ul>
    {
      cardLinks.length > 0 && (
        <div class="link-group">
          <p class="mono">{t(lang, 'links')}</p>
          <ul>
            {cardLinks.map((l) => (
              <li>
                <a href={l.href} target="_blank" rel="noopener">
                  {l.label} <span class="arr">↗</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
    <a class="case" href={url}>{t(lang, 'view_case')} <span class="arr">→</span></a>
  </div>

  <ProjectPanel class="slot" lang={lang} project={p} href={url} />
</article>

<style>
  .row {
    display: grid;
    gap: 24px;
    scroll-margin-top: 96px;
  }
  .row > :global(.slot) {
    order: -1;
  }
  @media (min-width: 900px) {
    .row {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 32px;
    }
    .text {
      grid-column: span 4;
      padding-top: 8px;
    }
    .row > :global(.slot) {
      order: 0;
      grid-column: span 8;
    }
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .meta {
    margin: 0;
    font-size: 13px;
    color: var(--faint);
  }
  h2 {
    margin: 0;
    font-size: clamp(28px, 3vw, 40px);
    line-height: 1.1;
  }
  h2 a {
    color: var(--text);
    background: linear-gradient(currentColor, currentColor) left bottom / 0 1px no-repeat;
    transition: background-size 0.3s ease;
  }
  h2 a:hover {
    text-decoration: none;
    background-size: 100% 1px;
  }
  .arr {
    display: inline-block;
    transition: transform 0.2s ease;
  }
  .blurb {
    margin: 0;
    font-size: 17px;
    line-height: 1.65;
    color: var(--body);
  }
  .barrier {
    padding-left: 16px;
    border-left: 2px solid var(--faint);
  }
  .barrier p {
    margin: 0;
    font-size: 15px;
    line-height: 1.7;
    color: var(--muted);
  }
  .barrier .mono {
    margin-bottom: 4px;
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--faint);
  }
  .link-group {
    margin-top: 24px;
  }
  .link-group p {
    margin: 0 0 6px;
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--faint);
  }
  .link-group ul {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 15px;
  }
  .link-group a {
    color: var(--muted);
    transition: color 0.2s ease;
  }
  .link-group a:hover {
    color: var(--text);
    text-decoration: none;
  }
  .link-group a:hover .arr {
    transform: translate(2px, -2px);
  }
  .link-group li {
    display: inline-block;
  }
  .link-group li:hover {
    animation: wiggle 0.4s ease;
  }
  @keyframes wiggle {
    20% { transform: rotate(-4deg); }
    40% { transform: rotate(3deg); }
    60% { transform: rotate(-2deg); }
    80% { transform: rotate(1deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .link-group li:hover {
      animation: none;
    }
  }
  .case {
    align-self: flex-start;
    margin-top: 28px;
    padding: 4px 0 2px;
    font-size: 15px;
    font-weight: 500;
    color: var(--text);
    border-bottom: 1px solid var(--text);
  }
  .case:hover {
    text-decoration: none;
  }
  .case:hover .arr {
    transform: translateX(4px);
  }

</style>
