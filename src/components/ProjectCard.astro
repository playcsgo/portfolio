---
import { Image } from 'astro:assets';
import type { Lang, Project } from '../data/projects';
import { t, tx, href } from '../data/site';

interface Props {
  lang: Lang;
  project: Project;
}
const { lang, project: p } = Astro.props;
const url = href(lang, `/${p.slug}/`);
const external = p.links[0];
const externalHref = external && (typeof external.href === 'string' ? external.href : tx(lang, external.href));
---

<article class="card">
  <header class="head">
    <div class="icon" aria-hidden="true">
      {p.icon ? <Image src={p.icon} alt="" width={96} height={96} format="webp" /> : <span class="mono">{p.iconText}</span>}
    </div>
    <div class="title">
      <h3><a href={url}>{tx(lang, p.title)}</a></h3>
      <span class="mono period">{p.period}</span>
    </div>
    <span class:list={['badge', p.status]}>{t(lang, `status_${p.status}`)}</span>
  </header>

  <p class="one-liner">{tx(lang, p.oneLiner)}</p>

  <div class="pain">
    <span class="eyebrow">{t(lang, 'pain')}</span>
    <p>{tx(lang, p.pain)}</p>
  </div>

  <ul class="tags">
    {p.stack.slice(0, 6).map((s) => <li>{s}</li>)}
  </ul>

  <footer class="links">
    <a class="more" href={url}>{t(lang, 'view_case')} →</a>
    {externalHref && (
      <a class="ext" href={externalHref} target="_blank" rel="noopener">
        {tx(lang, external.label)} ↗
      </a>
    )}
  </footer>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 20px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .card:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-md);
  }
  .head {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .icon {
    flex: none;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--surface-2);
    display: grid;
    place-items: center;
  }
  .icon img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .icon span {
    font-size: 13px;
    font-weight: 500;
    color: var(--accent);
  }
  .title {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  h3 {
    margin: 0;
    font-size: 18px;
  }
  h3 a {
    color: var(--text);
  }
  /* Whole card is clickable; external links sit above this layer */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .period {
    font-size: 12px;
    color: var(--faint);
  }
  .one-liner {
    margin: 0;
    font-weight: 500;
  }
  .pain .eyebrow {
    margin-bottom: 4px;
  }
  .pain p {
    margin: 0;
    font-size: 14px;
    color: var(--muted);
  }
  .links {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    font-size: 14px;
    font-weight: 500;
  }
  .ext {
    position: relative;
    z-index: 1;
    color: var(--muted);
  }
  .ext:hover {
    color: var(--text);
  }
</style>
