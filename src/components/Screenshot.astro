---
import { Image } from 'astro:assets';
import type { Lang, Shot } from '../data/projects';
import { tx } from '../data/site';

interface Props {
  lang: Lang;
  shot: Shot;
  sizes?: string;
  eager?: boolean;
}
const { lang, shot, sizes = '(min-width: 960px) 896px, 100vw', eager = false } = Astro.props;
---

<figure class="shot">
  <div class="frame">
    <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <Image
      src={shot.src[lang]}
      alt={tx(lang, shot.alt)}
      widths={[640, 960, 1280, 1920]}
      sizes={sizes}
      format="webp"
      quality={80}
      loading={eager ? 'eager' : 'lazy'}
    />
  </div>
  {shot.caption && <figcaption>{tx(lang, shot.caption)}</figcaption>}
</figure>

<style>
  .shot {
    margin: 0;
  }
  .frame {
    overflow: hidden;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: #16181b;
    box-shadow: var(--shadow-lg);
  }
  .dots {
    display: flex;
    gap: 6px;
    padding: 10px 12px;
    border-bottom: 1px solid #2a2e33;
  }
  .dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #3a3f45;
  }
  img {
    display: block;
    width: 100%;
    height: auto;
  }
  figcaption {
    margin-top: 12px;
    font-size: 14px;
    color: var(--muted);
  }
</style>
